{
  "name": "@enterpret/gmail-mcp",
  "version": "0.1.0",
  "description": "Minimal Gmail MCP for approved sending and label management",
  "keywords": [
    "mcp",
    "gmail",
    "google-workspace",
    "email",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Enterpret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aavaz-ai/gmail-mcp.git"
  },
  "homepage": "https://github.com/aavaz-ai/gmail-mcp#readme",
  "bugs": {
    "url": "https://github.com/aavaz-ai/gmail-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./contract": "./dist/contract.js"
  },
  "bin": {
    "gmail-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
